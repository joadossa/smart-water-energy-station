{
  "expo": {
    "name": "AquaPulse",
    "slug": "aquapulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aquapulse/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/aquapulse/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/aquapulse/favicon.png"
    },
    "backgroundColor": "#0B1220",
    "plugins": [
      "expo-font"
    ],
    "splash": {
      "image": "./assets/aquapulse/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    }
  }
}
